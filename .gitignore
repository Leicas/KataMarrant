node_modules/
dist/
target/
src-tauri/target/
# `tauri android/ios init` regenerates everything under src-tauri/gen/ on
# every CI run, so the contents are ignored. Hand-edited customisations
# (notification icon drawable, manifest permission additions, accent
# color) live under `src-tauri/android-patches/` and are re-applied
# post-init by `scripts/patch-android-gen.mjs`.
src-tauri/gen/
# Build artifacts written INTO the vendored plugin fork by `tauri android
# build` (gradle outputs + the .tauri api module tauri injects at build time).
# Only the crate SOURCE under src-tauri/vendor/ is tracked.
src-tauri/vendor/**/android/build/
src-tauri/vendor/**/android/.gradle/
src-tauri/vendor/**/android/.cxx/
src-tauri/vendor/**/android/.tauri/
src-tauri/vendor/**/android/local.properties
.venv/
.claude/
.DS_Store
*.log
.env
.env.local

# Android signing — never commit keystores or their credentials.
*.jks
*.keystore
key.properties

# Local-only secrets runbooks — anything matching `SECRETS.local.md` /
# `*.secrets.md` stays out of git. Use this name when stashing values
# you'll paste into GitHub Actions secrets / 1Password / etc.
SECRETS.local.md
*.secrets.md
.secrets/

# Dev screenshots / build artifacts (not for the public repo).
# Anchored at root so docs/screenshots/ stays committed for README assets.
/screenshots/
# Scratch screenshots dropped at the repo root with an underscore prefix
# (e.g. _swipetry.png) — used for in-progress UI experiments, never shipped.
/_*.png
build-android.log

# Auto-copied at build time from CHANGELOG.md (root) → src/CHANGELOG.md by
# tauri.conf.json beforeBuildCommand so the bundled app can fetch it for
# the in-app "What's new" view. The source of truth is the root CHANGELOG.md
# (regenerated by semantic-release); this copy is an ephemeral build artifact.
src/CHANGELOG.md

node_modules/
dist/
target/
src-tauri/target/
# `tauri android/ios init` regenerates everything under src-tauri/gen/, so
# the contents are ignored by default. We still need to track a small set
# of files we customise (manifest permissions, notification icon, color
# resources) because they are NOT regenerated on subsequent inits — Tauri
# preserves existing user-edited files. We therefore ignore everything
# under gen/ but un-ignore exactly the paths we own. Note: gitignore can
# only re-include a file if NO parent directory was ignored, which is why
# this uses a glob (`/**`) rather than a directory rule.
# Ignore everything Tauri's `tauri android/ios init` writes under
# src-tauri/gen/, except the small set of files we hand-edit (manifest
# permissions, notification small-icon drawable, color resources).
# Tauri preserves these on re-init, so they belong in git.
#
# Gitignore subtlety: re-including a file requires every parent directory
# to be reachable (i.e. NOT excluded by an earlier rule), so we ignore at
# the file-pattern level using `**/*` and explicitly un-ignore each
# parent directory in the path of every kept leaf.
src-tauri/gen/**/*
!src-tauri/gen/android/
!src-tauri/gen/android/app/
!src-tauri/gen/android/app/src/
!src-tauri/gen/android/app/src/main/
!src-tauri/gen/android/app/src/main/AndroidManifest.xml
!src-tauri/gen/android/app/src/main/res/
!src-tauri/gen/android/app/src/main/res/drawable/
!src-tauri/gen/android/app/src/main/res/drawable/ic_stat_quiz.xml
!src-tauri/gen/android/app/src/main/res/values/
!src-tauri/gen/android/app/src/main/res/values/colors.xml
.venv/
.claude/
.DS_Store
*.log
.env
.env.local

# Android signing — never commit keystores or their credentials.
*.jks
*.keystore
key.properties

# Local-only secrets runbooks — anything matching `SECRETS.local.md` /
# `*.secrets.md` stays out of git. Use this name when stashing values
# you'll paste into GitHub Actions secrets / 1Password / etc.
SECRETS.local.md
*.secrets.md
.secrets/

# Dev screenshots / build artifacts (not for the public repo).
# Anchored at root so docs/screenshots/ stays committed for README assets.
/screenshots/
# Scratch screenshots dropped at the repo root with an underscore prefix
# (e.g. _swipetry.png) — used for in-progress UI experiments, never shipped.
/_*.png
build-android.log

# Auto-copied at build time from CHANGELOG.md (root) → src/CHANGELOG.md by
# tauri.conf.json beforeBuildCommand so the bundled app can fetch it for
# the in-app "What's new" view. The source of truth is the root CHANGELOG.md
# (regenerated by semantic-release); this copy is an ephemeral build artifact.
src/CHANGELOG.md

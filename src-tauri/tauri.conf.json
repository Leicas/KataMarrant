{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KataMarrant",
  "version": "1.2.2",
  "identifier": "co.weill-duflos.katamarrant",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "KataMarrant",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' data:; connect-src 'self'; script-src 'self'; style-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Judo kata & gokyo trainer",
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {}
}

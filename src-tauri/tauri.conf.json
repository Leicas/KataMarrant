{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KataMarrant",
  "version": "1.5.1",
  "identifier": "fr.weill-duflos.katamarrant",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node -e \"require('fs').copyFileSync('CHANGELOG.md','src/CHANGELOG.md')\"",
    "beforeBuildCommand": "node -e \"require('fs').copyFileSync('CHANGELOG.md','src/CHANGELOG.md')\""
  },
  "app": {
    "windows": [
      {
        "title": "KataMarrant",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' data:; connect-src 'self'; script-src 'self'; style-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Judo kata & gokyo trainer",
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNjQ4NUY3QkIxRDNDODgKUldTSVBCMjc5NFZrVUppa1pOT0ZMMEVQZUM4VDZ4NGtIUDBGd29ER3RGLzU3QjhKNWVicDRLbHMK",
      "endpoints": [
        "https://github.com/Leicas/KataMarrant/releases/latest/download/latest.json",
        "https://github.com/Leicas/KataMarrant/releases/download/beta-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
